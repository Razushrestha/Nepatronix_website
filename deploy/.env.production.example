# Copy to /var/www/nepatronix/.env.local on the VPS
# cp deploy/.env.production.example .env.local && nano .env.local

NODE_ENV=production

# Site URL (must match your domain)
NEXT_PUBLIC_BASE_URL=https://nepatronix.org

# MongoDB on same VPS (no auth — default fresh install)
MONGODB_URI=mongodb://127.0.0.1:27017/nepatronix

# If MongoDB has authentication enabled, use instead:
# MONGODB_URI=mongodb://nepatronix:YOUR_PASSWORD@127.0.0.1:27017/nepatronix?authSource=nepatronix

# Admin auth — CHANGE THESE before going live
JWT_SECRET=replace-with-long-random-string
ADMIN_SECRET=replace-with-strong-bootstrap-password
ADMIN_EMAIL=admin@nepatronix.org

# Contact form (Web3Forms)
WEB3FORMS_KEY=your-web3forms-key

# Certificate assets (optional — defaults work if files are in /public)
LOGO_URL=/logo.png
NEXT_PUBLIC_LOGO_URL=/logo.png
SIGNATORY_IMAGE_URL=/signature.png
NEXT_PUBLIC_SIGNATORY_IMAGE_URL=/signature.png
SIGNATORY_NAME=Raju Shrestha
NEXT_PUBLIC_SIGNATORY_NAME=Raju Shrestha
SIGNATORY_TITLE=CEO and Founder
NEXT_PUBLIC_SIGNATORY_TITLE=CEO and Founder
PARTNER_LOGO_1_URL=/pravartak.png
NEXT_PUBLIC_PARTNER_LOGO_1_URL=/pravartak.png
PARTNER_LOGO_2_URL=/innovator.png
NEXT_PUBLIC_PARTNER_LOGO_2_URL=/innovator.png

# Optional
BLOG_WEBHOOK_SECRET=
NEXT_PUBLIC_FACEBOOK_REEL_URL=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0
