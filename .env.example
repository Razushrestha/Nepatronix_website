# Site URL
NEXT_PUBLIC_BASE_URL=https://nepatronix.org
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/nepatronix

# Admin auth
ADMIN_SECRET=your_admin_secret_here
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@nepatronix.org

# Contact form (Web3Forms)
WEB3FORMS_KEY=your_web3forms_key_here

# Optional: webhook secret for /api/notify-subscribers
BLOG_WEBHOOK_SECRET=your_webhook_secret_here

# Task attachments — max file size per upload in MB (images, PDF, video; default 512)
TASK_MAX_UPLOAD_MB=512
NEXT_PUBLIC_TASK_MAX_UPLOAD_MB=512

# Optional: HR office overrides (see HR Settings in admin)
# HR_ATTENDANCE_START_DATE=2026-07-17
NEXT_PUBLIC_FACEBOOK_REEL_URL=https://www.facebook.com/reel/1104098458271218

# Facebook gallery sync (scripts/sync-facebook-gallery.mjs)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_API_VERSION=v21.0
